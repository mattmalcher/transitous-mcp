// Deployed CPU check only. Its own name, so the live transitous-mcp is untouched. Delete after use.
{
  "name": "transitous-cpu-spike",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "vars": {
    "TRANSITOUS_USER_AGENT": "transitous-mcp/0.1.0-cpu-check (+https://github.com/mattmalcher)"
  },
  "durable_objects": { "bindings": [{ "name": "TRANSITOUS", "class_name": "TransitousGateway" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TransitousGateway"] }],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
